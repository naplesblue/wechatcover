# 复制本文件为 .env 并填入你的 key
#   cp .env.example .env

# ── 出图后端 ──
# 默认 openai（GPT-Image-2，中文文字渲染强，需外卡）
OPENAI_API_KEY=

# 切换出图后端：openai（默认）| qwen（通义千问 Qwen-Image，国内可支付宝充值、中文渲染强）
# IMAGE_PROVIDER=qwen
#   qwen 用 DASHSCOPE_API_KEY（见下）。可选覆盖：
#   QWEN_IMAGE_MODEL=qwen-image-2.0-pro-2026-04-22  # Qwen 文生图模型（默认此快照）
#   QWEN_IMAGE_SIZE=1664x928         # 若 1920x816 被尺寸限制拒绝，换成支持的尺寸/比例

# ── 艺术指导 LLM（必需，默认走 DeepSeek）──
DEEPSEEK_API_KEY=

# 可选：默认艺术指导模型（不设则用 deepseek-v4-flash）
#   也可命令行 --model 覆盖；推理强度 --effort low|high|max（默认 high）
# GEN_COVER_MODEL=deepseek-v4-flash

# 可选：DashScope key —— 同时供「Qwen 艺术指导」和「Qwen-Image 出图」使用
#   艺术指导改 Qwen: --model qwen-plus 或 GEN_COVER_MODEL=qwen-plus
# DASHSCOPE_API_KEY=
